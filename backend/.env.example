# This file is the SELF-HOST and LOCAL-DEV manifest. `setup.sh` / `setup.ps1` seed
# `backend/.env` from it, and `docker-compose.prod.yml` reads that file.
#
# MANAGED HOSTING DOES NOT USE THIS FILE. A managed deployment's environment is declared
# in `render.yaml` and `deploy/render.managed.yaml`, and both are drift-guarded by
# `backend/tests/test_env_surface_drift.py::PRODUCTION_MANIFESTS`. Add a managed setting
# THERE, not here — a fourth manifest that nobody deploys from is exactly the file that
# rots unnoticed.
#
# The two surfaces differ on purpose:
#   * Managed-only, because the platform owns them: MANAGED_POSTGRES, PLATFORM_ORIGIN_HOST,
#     PLATFORM_DOMAIN_SUFFIX, PLATFORM_STAFF_ORIGINS, CRON_SECRET, BEHIND_TRUSTED_PROXY,
#     TRUSTED_PROXY_COUNT, TRUST_X_FORWARDED_PROTO, SECURE_HSTS_SECONDS,
#     CSRF_TRUSTED_ORIGINS, ENABLE_HTTPS, CONN_MAX_AGE, BACKUP_AGE_RECIPIENT, VITE_*.
#   * Present only here: the tuning knobs — THROTTLE_*, the *_TTL_SECONDS and *_MAX_BYTES
#     caps, the ALLOWED_EXT/ALLOWED_MIME lists. Their defaults are already correct off-box,
#     so the production manifests deliberately omit them rather than restate them.
# Anything whose default is only right on this machine (a localhost URL, a dev secret) must
# appear in BOTH, which is what the drift guard enforces.
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_SITE_NAME=Space Works
DATABASE_URL=postgres://makerspace:makerspace@localhost:5432/makerspace_manager
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173
# Absolute base for links in outbound email (password reset, invitations). REQUIRED for a
# working forgot-password flow: if unset, links are emitted as bare paths such as
# "/reset-password?uid=..." which are not clickable in an email client.
PUBLIC_APP_BASE_URL=http://localhost:5000
HMAC_CLIENT_ID=
HMAC_SECRET=
HMAC_MAX_CLOCK_SKEW_SECONDS=300
# Both enforcement switches ship OFF. With API_CLIENT_AUTH_REQUIRED=False an unsigned
# request to a protected path falls through as anonymous and DRF authorization still
# applies, while every request that WOULD be rejected is logged. Run
#   python manage.py api_client_enforcement_report
# to see what still stands in the way before turning either on.
API_CLIENT_AUTH_REQUIRED=False
APICLIENT_REQUIRE_NONCE=False
# Adding a prefix here requires every route under it to be in the API-client scope
# registry; `manage.py check` fails with the list if any is missing, rather than the
# deployment silently 401-ing that whole prefix.
HMAC_PROTECTED_PATH_PREFIXES=/api/public/,/api/v1/public/
# Fernet key for ApiClient, Telegram bot token, and makerspace SMTP password
# encryption. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_CLIENT_ENC_KEY=
DEVICE_ATTESTATION_APPS={}
DEVICE_APPLE_ATTESTATION_VERIFY_URL=
DEVICE_APPLE_ATTESTATION_VERIFY_TOKEN=
DEVICE_ANDROID_ATTESTATION_VERIFY_URL=
DEVICE_ANDROID_ATTESTATION_VERIFY_TOKEN=
DEVICE_ATTESTATION_CHALLENGE_TTL_SECONDS=180
DEVICE_ATTESTATION_PROVIDER_TIMEOUT_SECONDS=10
THROTTLE_DEVICE_ATTESTATION_CHALLENGE=5/min
THROTTLE_DEVICE_LOGIN=5/min
THROTTLE_DEVICE_LOGIN_USER=10/hour
THROTTLE_DEVICE_REFRESH=30/min
THROTTLE_PUSH_DEVICE_REGISTRATION=10/min
# Independent 32+ character HMAC key; do not reuse an API or provider credential.
PUSH_TOKEN_HMAC_KEY=
SOCIAL_AUTH_NONCE_TTL_SECONDS=300
OIDC_ATTEMPT_TTL_SECONDS=300
OIDC_HTTP_TIMEOUT_SECONDS=5
OIDC_HTTP_MAX_BYTES=65536
OIDC_DISCOVERY_CACHE_SECONDS=300
THROTTLE_SOCIAL_NONCE=10/min
THROTTLE_SOCIAL_LOGIN=10/min
# Stripe Connect OAuth callback. Empty keeps managed Connect dormant.
STRIPE_CONNECT_REDIRECT_URI=

# Production (separate HTTPS origins): leave defaults (SameSite=None, Secure=True).
# Local dev: serve the frontend via a same-origin Vite proxy to :8000 and set:
# AUTH_COOKIE_SAMESITE=Lax
# AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=None
AUTH_COOKIE_SECURE=True

# MinIO evidence storage for host-dev. For a dockerized backend, use the internal
# endpoint (http://minio:9000) for AWS_S3_ENDPOINT_URL and the public endpoint
# (http://localhost:9000) for AWS_S3_PUBLIC_ENDPOINT_URL; out of scope this phase.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=evidence
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
EVIDENCE_URL_TTL_SECONDS=300
EVIDENCE_MAX_BYTES=10485760
# Private machine and maintenance document formats (comma-separated).
MACHINE_DOC_ALLOWED_EXT=pdf,jpg,jpeg,png,webp,stl,3mf,step,stp,obj,amf,ply,gcode,gco,iges,igs,dxf
MACHINE_DOC_ALLOWED_MIME=application/pdf,image/jpeg,image/png,image/webp,application/octet-stream,model/stl,application/sla,application/vnd.ms-pki.stl,model/3mf,application/vnd.ms-package.3dmanufacturing-3dmodel+xml,application/vnd.ms-3mfdocument,application/step,model/step,model/obj,application/xml,text/xml,application/x-amf,model/amf,application/x-ply,model/ply,text/x.gcode,application/x-gcode,application/iges,model/iges,image/vnd.dxf,application/dxf,application/x-dxf,text/plain
# Private print model/CAD/toolpath formats (comma-separated).
PRINT_ALLOWED_MODEL_EXT=stl,3mf,step,stp,obj,amf,ply,gcode,gco,iges,igs,dxf
PRINT_ALLOWED_MODEL_MIME=application/octet-stream,model/stl,application/sla,application/vnd.ms-pki.stl,model/3mf,application/vnd.ms-package.3dmanufacturing-3dmodel+xml,application/vnd.ms-3mfdocument,application/step,model/step,model/obj,application/xml,text/xml,application/x-amf,model/amf,application/x-ply,model/ply,text/x.gcode,application/x-gcode,application/iges,model/iges,image/vnd.dxf,application/dxf,application/x-dxf,text/plain
# Public catalog images use a separate anonymous-read bucket. Never store
# private evidence or handover photos here.
PUBLIC_IMAGE_BUCKET=public-images
PUBLIC_IMAGE_BASE_URL=http://localhost:9000/public-images
PUBLIC_IMAGE_MAX_BYTES=5242880
PUBLIC_IMAGE_URL_TTL_SECONDS=300

# Public request workflow throttle scopes.
THROTTLE_REQUEST_SUBMIT=10/min
THROTTLE_REQUEST_STATUS=60/min

# Email defaults use the console backend for local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Space Works <noreply@spaceworks.local>

# Telegram. Per-makerspace bot tokens + group chat ids live in the DB; these are the
# optional global fallback bot and the webhook auth secret. TELEGRAM_WEBHOOK_SECRET must
# be set for accept/reject webhook callbacks to be trusted — the webhook fails closed
# (rejects every callback) when it is unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Audit attestation. Keyed MAC over every audit row, then signed Merkle batches over sets
# of those rows. Both halves are OPT-IN and a blank config is a valid boot state: with no
# master key a row stores row_mac = NULL plus a CRITICAL log, and never fails the request
# — record() sits on every state-changing path, so failing closed would stop staff issuing
# hardware. Generate the key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# On a deployment that already has audit history, set the key and then run:
#   python manage.py provision_audit_mac_keys --all
# Verify at any time with `manage.py verify_audit_log`.
AUDIT_MAC_MASTER_KEY=

# Anchoring publishes each signed batch off-box, which is what makes the chain evidence
# against someone who owns the database. A blank ANCHOR_BACKEND leaves it dormant.
AUDIT_ATTESTATION_DEPLOYMENT_ID=
AUDIT_ATTESTATION_ANCHOR_BACKEND=
AUDIT_ATTESTATION_S3_BUCKET=
AUDIT_ATTESTATION_S3_PREFIX=spaceworks-audit/v1
AUDIT_ATTESTATION_RETENTION_DAYS=2555
AUDIT_ATTESTATION_S3_OBJECT_LOCK_MODE=COMPLIANCE
# The four below fall back to the main AWS_* values above when left blank. Point them at a
# SEPARATE account or bucket if the anchor is to survive someone with this deployment's
# storage credentials.
AUDIT_ATTESTATION_S3_ENDPOINT_URL=
AUDIT_ATTESTATION_S3_ACCESS_KEY_ID=
AUDIT_ATTESTATION_S3_SECRET_ACCESS_KEY=
AUDIT_ATTESTATION_S3_REGION_NAME=
AUDIT_ATTESTATION_HTTP_URL=
AUDIT_ATTESTATION_HTTP_BEARER_TOKEN=
AUDIT_ATTESTATION_HTTP_TIMEOUT=10
