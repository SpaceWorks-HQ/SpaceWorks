{
    email "{$TLS_EMAIL}"
}
import {$STORAGE_CADDY_CONFIG:/etc/caddy/storage-disabled.caddy}
{$PUBLIC_DOMAIN} {
    encode zstd gzip

    handle /api/v1/internal/* {
        respond 403
    }
    handle /api/v1/live/* {
        reverse_proxy live:8000
    }

    @backend path /api/* /static/* /docs* /redoc* /schema*
    reverse_proxy @backend backend:8000 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
    }

    reverse_proxy {$SPACEWORKS_WEB_UPSTREAM:frontend:80}
}
