{
  "compilerOptions": {
    "composite": true,
    // Emit the composite artifacts into a scratch dir instead of next to the
    // source. `tsc -b` used to drop a vite.config.js beside vite.config.ts, and
    // Vite resolves .js BEFORE .ts — so a stale build artifact silently shadowed
    // the real config (it went unnoticed only while the two files agreed).
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}
