# Python / Django
__pycache__/
*.py[cod]
.venv/
venv/
*.sqlite3
backend/.env
# Root deployment env written by setup.sh / setup.ps1 (holds generated secrets).
/.env
/backups/
/.spaceworks-version
/.spaceworks-update.lock
staticfiles/

# Node / Vite
node_modules/
frontend/dist/
frontend/.env

# tsc -b composite build artifacts. tsconfig.node.json now emits into
# frontend/node_modules/.tmp (already ignored) — a vite.config.js sitting beside
# vite.config.ts shadows it, because Vite resolves .js first. These two entries
# stay so a stale artifact from an older checkout can never be committed.
frontend/vite.config.js
frontend/vite.config.d.ts
*.tsbuildinfo

# Codex / agent scratch prompts + orchestration artifacts
.codex-prompt-*.txt
.cbrand*.txt
.cplan.md

# Internal planning + design docs — kept local, not published to the repo.
# Only curated user/ops docs are committed (e.g. docs/setup-for-makerspaces.md,
# docs/self-hosting.md).
# Internal feature report (per-feature rationale + managed/self-host limitations).
report/
docs/prd-*.md
docs/PLAN-prd-*.md
docs/superpowers/
docs/design/
docs/plans/
docs/*-plan.md
docs/plan-*.md
docs/HANDOVER.md

# Docker Compose local override — machine-specific dev config (ports, bind mounts).
# Each developer keeps their own; it is auto-merged by `docker compose` and must not be committed.
docker-compose.override.yml
# Host dev launcher — hardcodes the same machine-specific ports as the override above.
scripts/dev-local.sh
docs/roadmap.md

# OS / editor
.DS_Store
.idea/
.vscode/
